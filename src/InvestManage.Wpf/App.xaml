<Application x:Class="InvestManage.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2457A6" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F6F8FB" />
        <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Application.Resources>
</Application>
