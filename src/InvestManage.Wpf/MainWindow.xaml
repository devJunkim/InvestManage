<Window x:Class="InvestManage.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:InvestManage.Wpf.Views"
        Title="InvestManage" Height="850" Width="1380" MinHeight="650" MinWidth="1050"
        Background="{StaticResource SurfaceBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#17365D" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="InvestManage" Foreground="White" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Windows investment management" Foreground="#D7E4F3" FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ApiStatus}" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Check API" Command="{Binding CheckApiCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Margin="18">
            <TabItem Header="User access">
                <views:UserAccessView DataContext="{Binding UserAccess}" />
            </TabItem>
            <TabItem Header="Accounts" IsEnabled="{Binding IsAuthenticated}">
                <views:AccountsView DataContext="{Binding Accounts}" />
            </TabItem>
            <TabItem Header="Investments" IsEnabled="{Binding IsAuthenticated}">
                <views:InvestmentsView DataContext="{Binding Investments}" />
            </TabItem>
            <TabItem Header="Transactions" IsEnabled="{Binding IsAuthenticated}">
                <views:TransactionsView DataContext="{Binding Transactions}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
